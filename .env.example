NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Copy this file to .env.local and fill in local secrets. Never commit .env.local.
MONGODB_URI=
MONGO_DB_NAME=test
SESSION_SECRET=replace-with-a-long-random-secret

# Server-only Cloudflare R2 credentials. See docs/R2_SETUP.md.
# Local development uses a token restricted to make-my-marriage-develop.
# Production must use a separate token restricted to make-my-marriage-prod.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=make-my-marriage-develop

RESEND_API_KEY=replace-with-your-resend-api-key
# onboarding@resend.dev is limited to the email address on the Resend account.
# Verify a domain and use its sender address to deliver to other recipients.
RESEND_FROM_EMAIL="Make My Marriage <onboarding@resend.dev>"
GOOGLE_PLACES_API_KEY=
CRON_SECRET=
